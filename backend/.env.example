# AutoBB Web UI — backend configuration
# Copy to .env and adjust.

# --- MongoDB (read-only) ---
# Point this at the same MongoDB the autobb pipeline writes to.
# Use a read-only Mongo user in production.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=autobbdb

# --- Temporal model ---
# Default "alive" window in days (mirrors export.py).
DEFAULT_ALIVE_DAYS=30

# --- Auth gate ---
# If set, every /api request must carry this token via
#   Authorization: Bearer <token>   or   X-Auth-Token: <token>
# Leave empty to DISABLE auth (development only).
AUTH_TOKEN=

# --- CORS ---
# Comma-separated list of allowed SPA origins (Vite dev server default below).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Networking ---
# Do NOT bind to a public interface. Keep 127.0.0.1 or run behind a proxy/VPN.
HOST=127.0.0.1
PORT=8000

# --- Optional: serve the built SPA from FastAPI ---
# Absolute or relative path to the frontend build output. If it exists, it is
# mounted at "/" so the API and UI are served from a single origin.
FRONTEND_DIST=../frontend/dist

# --- Optional: scope names source ---
# Path to an autobb-style scopes/config YAML to derive the canonical scope list.
# If unset (default), scope names are derived from distinct `scope` values in the DB.
SCOPES_CONFIG=
